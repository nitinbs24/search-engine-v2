{
  "size": 50,
  "_source": {
    "excludes": ["text_embedding"]
  },
  "query": {
    "hybrid": {
      "queries": [
        {
          "bool": {
            "must": [
              {
                "multi_match": {
                  "query": "kubernetes report",
                  "fields": [
                    "filename^3",
                    "title^2",
                    "chunk_text"
                  ]
                }
              }
            ],
            "filter": [
              {
                "bool": {
                  "minimum_should_match": 1,
                  "should": [
                    {
                      "terms": {
                        "extension": [
                          "pdf",
                          "ppt"
                        ]
                      }
                    },
                    {
                      "prefix": {
                        "mime_type": "image/"
                      }
                    }
                  ]
                }
              },
              {
                "range": {
                  "size_bytes": {
                    "gt": 5242880,
                    "lt": 1073741824
                  }
                }
              },
              {
                "range": {
                  "uploaded_at": {
                    "gte": "2026-03-04T00:00:00+05:30",
                    "lt": "2026-03-05T00:00:00+05:30"
                  }
                }
              }
            ]
          }
        },
        {
          "knn": {
            "text_embedding": {
              "vector": [
                0.25,
                0.75
              ],
              "k": 50,
              "filter": {
                "bool": {
                  "filter": [
                    {
                      "bool": {
                        "minimum_should_match": 1,
                        "should": [
                          {
                            "terms": {
                              "extension": [
                                "pdf",
                                "ppt"
                              ]
                            }
                          },
                          {
                            "prefix": {
                              "mime_type": "image/"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "range": {
                        "size_bytes": {
                          "gt": 5242880,
                          "lt": 1073741824
                        }
                      }
                    },
                    {
                      "range": {
                        "uploaded_at": {
                          "gte": "2026-03-04T00:00:00+05:30",
                          "lt": "2026-03-05T00:00:00+05:30"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "knn": {
            "image_embedding": {
              "vector": [
                0.5,
                0.5,
                0.0
              ],
              "k": 50,
              "filter": {
                "bool": {
                  "filter": [
                    {
                      "bool": {
                        "minimum_should_match": 1,
                        "should": [
                          {
                            "terms": {
                              "extension": [
                                "pdf",
                                "ppt"
                              ]
                            }
                          },
                          {
                            "prefix": {
                              "mime_type": "image/"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "range": {
                        "size_bytes": {
                          "gt": 5242880,
                          "lt": 1073741824
                        }
                      }
                    },
                    {
                      "range": {
                        "uploaded_at": {
                          "gte": "2026-03-04T00:00:00+05:30",
                          "lt": "2026-03-05T00:00:00+05:30"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
