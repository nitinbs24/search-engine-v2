# Copy to .env (make up does this for you if .env is missing).
# Local-development credentials only.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=uploads
KAFKA_TOPIC=file-upload-events
KAFKA_DLQ_TOPIC=file-upload-events-dlq
KAFKA_DLQ_FAILED_TOPIC=file-upload-events-dlq-failed
OPENSEARCH_INDEX=search-docs
# Optional generated answers (needs a GPU image and a CUDA device; ignored otherwise). 1 to enable.
ANSWER_ENABLED=0
